{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "foldkit": {
            "enabled": true,
            "type": "local",
            "command": [
                "bunx",
                "--bun",
                "@foldkit/devtools-mcp"
            ]
        }
    },
    "lsp": {
        "typescript": {
            "command": [
                "bunx",
                "tsc",
                "--lsp",
                "--stdio"
            ],
            "extensions": [
                ".ts",
                ".tsx",
                ".js",
                ".jsx",
                ".mjs",
                ".cjs",
                ".mts",
                ".cts",
                ".json"
            ]
        }
    },
    "references": {
        "effect": "./repos/effect",
        "foldkit": "./repos/foldkit"
    },
    "permission": "allow"
}
