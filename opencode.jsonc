{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "foldkit": {
      "enabled": true,
      "type": "local",
      "command": [
        "bunx",
        "--bun",
        "@foldkit/devtools-mcp"
      ]
    }
  },
  "lsp": {
    "typescript": {
      "command": [
        "bunx",
        "tsc",
        "--lsp",
        "--stdio"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".mts",
        ".cts",
        ".json"
      ]
    }
  },
  "references": {
    "foldkit": {
      "repository": "foldkit/foldkit",
      "branch": "main",
      "description": "Foldkit conventions and APIs. The vendored, version-pinned checkout at repos/foldkit is faster and matches the installed packages."
    },
    "effect": {
      "repository": "Effect-TS/effect",
      "branch": "main",
      "description": "Effect, Schema, Stream, Match, and the unstable HTTP APIs. node_modules/effect/AGENTS.md and node_modules/effect/ai-docs/src are the local references."
    }
  },
  "permission": "allow"
}
