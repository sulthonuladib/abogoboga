{
  "name": "@arbitrator/lister",
  "description": "Cryptocurrency, exchange, network, and metadata API.",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "apps/workers/*"
  ],
  "type": "module",
  "module": "apps/control-plane-api/src/index.ts",
  "catalog": {
    "effect": "4.0.0-rc.117",
    "@effect/platform-bun": "4.0.0-rc.115",
    "@effect/platform-node": "4.0.0-rc.117",
    "@effect/platform-node-shared": "4.0.0-rc.117",
    "@effect/platform-browser": "4.0.0-rc.117",
    "@effect/sql-pg": "4.0.0-rc.115",
    "@effect/tsgo": "0.46.1",
    "foldkit": "0.163.0",
    "@foldkit/devtools": "0.163.0",
    "@foldkit/devtools-mcp": "0.22.0",
    "@foldkit/oxlint-plugin": "0.15.0",
    "@foldkit/ui": "0.163.0",
    "@foldkit/vite-plugin": "0.24.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@happy-dom/global-registrator": "^20.11.13",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "clsx": "^2.1.1",
    "happy-dom": "^20.11.13",
    "lucide": "^1.33.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.85.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.0",
    "@effect/sql-pglite": "4.0.0-rc.117",
    "@effect/atom-react": "4.0.0-rc.117"
  },
  "scripts": {
    "dev": "bun run --watch apps/control-plane-api/src/index.ts",
    "start": "bun run apps/control-plane-api/src/index.ts",
    "dev:web": "bun run --cwd apps/folding-plane dev",
    "build:web": "bun run --cwd apps/folding-plane build",
    "test": "bun test --isolate ./packages ./apps",
    "test:web": "bun run --cwd apps/folding-plane test",
    "typecheck": "bunx tsc --noEmit",
    "typecheck:web": "bun run --cwd apps/folding-plane typecheck",
    "lint": "bunx oxlint --type-aware ./packages ./apps ./test-setup.ts",
    "format": "oxfmt",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed:tester": "bun run apps/cli/src/index.ts seed tester",
    "scan:fetch": "bun run apps/cli/src/index.ts scan fetch",
    "scan:import": "bun run apps/cli/src/index.ts scan import",
    "prepare": "effect-tsgo patch --typescript --oxlint"
  },
  "dependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@fontsource-variable/inter": "catalog:",
    "@lister/db": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "catalog:",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@oxlint/plugins": "1.85.0",
    "@types/bun": "^1.4.2",
    "drizzle-kit": "1.0.0-rc.4",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "7.0.2003",
    "postgres": "^3.4.9",
    "typescript": "catalog:",
    "typescript-language-server": "^6.0.1",
    "@effect/tsgo": "catalog:"
  },
  "patchedDependencies": {
    "drizzle-orm@1.0.0-rc.4": "patches/drizzle-orm@1.0.0-rc.4.patch"
  }
}
