{
  "name": "@arbitrator/lister",
  "description": "Cryptocurrency, exchange, network, and metadata API.",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["packages/*", "apps/*", "apps/workers/*"],
  "type": "module",
  "module": "apps/control-plane/src/index.ts",
  "scripts": {
    "dev": "bun run --watch apps/control-plane/src/index.ts",
    "css:build": "bunx @tailwindcss/cli -i apps/control-plane/src/web/styles.css -o public/static/app.css",
    "css:watch": "bunx @tailwindcss/cli -i apps/control-plane/src/web/styles.css -o public/static/app.css --watch",
    "start": "bun run apps/control-plane/src/index.ts",
    "test": "bun test packages apps",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx oxlint --type-aware",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed:tester": "bun run apps/cli/src/index.ts seed tester",
    "scan:fetch": "bun run apps/cli/src/index.ts scan fetch",
    "scan:import": "bun run apps/cli/src/index.ts scan import",
    "prepare": "effect-tsgo patch --typescript --oxlint"
  },
  "dependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@lister/db": "workspace:*",
    "daisyui": "^5.7.46",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "^4.0.0-rc.117",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@effect/platform-bun": "^4.0.0-rc.115",
    "@effect/sql-pg": "^4.0.0-rc.115",
    "@oxlint/plugins": "1.85.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "^1.4.2",
    "drizzle-kit": "1.0.0-rc.4",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "postgres": "^3.4.9",
    "typescript": "^7.0.2",
    "typescript-language-server": "^6.0.1",
    "@effect/tsgo": "0.46.1"
  },
  "patchedDependencies": {
    "drizzle-orm@1.0.0-rc.4": "patches/drizzle-orm@1.0.0-rc.4.patch"
  }
}
