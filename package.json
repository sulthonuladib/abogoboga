{
  "name": "@arbitrator/lister",
  "description": "Cryptocurrency, exchange, network, and metadata API.",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "apps/workers/*"
  ],
  "type": "module",
  "module": "apps/control-plane-api/src/index.ts",
  "catalog": {
    "effect": "4.0.0",
    "@effect/platform-bun": "4.0.0",
    "@effect/platform-node": "4.0.0",
    "@effect/platform-node-shared": "4.0.0",
    "@effect/platform-browser": "4.0.0",
    "@effect/sql-pg": "4.0.0",
    "@effect/tsgo": "0.47.2",
    "foldkit": "0.164.0",
    "@foldkit/devtools": "0.164.0",
    "@foldkit/devtools-mcp": "0.23.0",
    "@foldkit/oxlint-plugin": "0.15.1",
    "@foldkit/ui": "0.164.0",
    "@foldkit/vite-plugin": "0.25.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "happy-dom": "^20.14.5",
    "oxfmt": "^0.71.0",
    "oxlint": "1.86.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "@effect/sql-pglite": "4.0.0"
  },
  "scripts": {
    "dev": "bun run --watch apps/control-plane-api/src/index.ts",
    "start": "bun run apps/control-plane-api/src/index.ts",
    "dev:web": "bun run --cwd apps/folding-plane dev",
    "build:web": "bun run --cwd apps/folding-plane build",
    "test": "bun test --concurrent ./packages ./apps",
    "test:web": "bun run --cwd apps/folding-plane test",
    "typecheck": "bunx tsc --noEmit",
    "typecheck:web": "bun run --cwd apps/folding-plane typecheck",
    "lint": "bunx oxlint --type-aware ./packages ./apps ./tools",
    "format": "oxfmt",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed:tester": "bun run apps/cli/src/index.ts seed tester",
    "scan:fetch": "bun run apps/cli/src/index.ts scan fetch",
    "scan:import": "bun run apps/cli/src/index.ts scan import",
    "prepare": "effect-tsgo patch --typescript --oxlint"
  },
  "dependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@fontsource-variable/inter": "catalog:",
    "@lister/db": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "catalog:",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@oxlint/plugins": "1.86.0",
    "@types/bun": "^1.4.2",
    "drizzle-kit": "1.0.0-rc.4",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "7.0.2003",
    "postgres": "^3.4.9",
    "typescript": "catalog:",
    "typescript-language-server": "^6.0.1",
    "@effect/tsgo": "catalog:"
  },
  "patchedDependencies": {
    "drizzle-orm@1.0.0-rc.4": "patches/drizzle-orm@1.0.0-rc.4.patch",
    "foldkit@0.164.0": "patches/foldkit@0.164.0.patch",
    "@foldkit/devtools@0.164.0": "patches/@foldkit%2Fdevtools@0.164.0.patch"
  }
}
