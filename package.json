{
  "name": "@arbitrator/lister",
  "description": "Cryptocurrency, exchange, network, and metadata API.",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "css:build": "bunx @tailwindcss/cli -i src/web/styles.css -o public/static/app.css",
    "css:watch": "bunx @tailwindcss/cli -i src/web/styles.css -o public/static/app.css --watch",
    "start": "bun run src/index.ts",
    "test": "bun test tests",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx oxlint --type-aware --ignore-pattern 'src/crawl-workers/**'",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed:coins": "bun run src/seed/coin-data.ts",
    "db:seed:tester": "bun run src/seed/tester-exchanges.ts"
  },
  "dependencies": {
    "@elysiajs/html": "^1.4.2",
    "@elysiajs/static": "^1.4.10",
    "@orpc/client": "^2.0.0-beta.36",
    "@orpc/openapi": "^2.0.0-beta.36",
    "@orpc/publisher": "^2.0.0-beta.36",
    "@orpc/server": "^2.0.0-beta.36",
    "@orpc/zod": "^2.0.0-beta.36",
    "bitget-api": "^3.2.3",
    "daisyui": "^5",
    "drizzle-orm": "1.0.0-rc.4",
    "drizzle-seed": "1.0.0-rc.4",
    "drizzle-zod": "^0.8.3",
    "effect": "^4.0.0-rc.115",
    "elysia": "^1.4.30",
    "elysia-htmx": "^2.0.0",
    "tailwindcss": "^4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@effect/platform-bun": "^4.0.0-rc.115",
    "@effect/sql-pg": "^4.0.0-rc.115",
    "@oxlint/plugins": "1.83.0",
    "@tailwindcss/cli": "^4",
    "@types/bun": "^1.4.2",
    "drizzle-kit": "1.0.0-rc.4",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postgres": "^3.4.9",
    "typescript": "^7.0.2",
    "typescript-language-server": "^6.0.0"
  }
}
