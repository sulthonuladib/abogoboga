POSTGRES_USER=abogoboga
POSTGRES_PASSWORD=abogoboga
POSTGRES_DB=abogoboga
POSTGRES_PORT=5432

# Keep these URLs in sync if you change the credentials or port above.
DATABASE_URL=postgres://abogoboga:abogoboga@localhost:5432/abogoboga
DATABASE_URL_TEST=postgres://abogoboga:abogoboga@localhost:5432/abogoboga_test

# Comma-separated browser origins. Unset allows all origins only in development.
# CORS_ORIGINS=http://localhost:3000

# CoinGecko Demo API key used by `lister scan fetch`. Unset falls back to the
# keyless public endpoint, which has a much lower rate limit.
# COINGECKO_DEMO_API_KEY=

# Local OpenTelemetry trace export, read by every traced process.
#
# Start the collector with `docker compose up -d jaeger`, then open the UI at
# http://localhost:16686. The endpoint below is the collector's OTLP/HTTP port,
# which the `jaeger` service publishes from `docker-compose.yml`; the exporter
# appends `/v1/traces` to it. Each process reports its own service name through
# its observability layer rather than through OTEL_SERVICE_NAME.
#
# Traces only: OTEL_LOGS_EXPORTER and OTEL_METRICS_EXPORTER are deliberately
# absent, so no log or metric payloads are sent. Comment out these two lines to
# run without a collector, which disables export entirely.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_EXPORTER=otlp
